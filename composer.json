{
    "name": "jwage/purl",
    "type": "library",
    "description": "URL Manipulation for PHP 5.3",
    "keywords": ["url", "manipulation"],
    "homepage": "http://github.com/jwage/purl",
    "license": "MIT",
    "authors": [
        {"name": "Jonathan H. Wage", "email": "jonwage@gmail.com"}
    ],
    "autoload": {
        "psr-4": {"Purl\\": "src/Purl"}
    },
    "autoload-dev": {
        "psr-4": {"Purl\\Test\\": "tests/Purl/Test"}
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "doctrine/coding-standard": "^14.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.3",
        "rector/rector": "^2.6"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    }
}
